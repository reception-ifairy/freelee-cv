# ---------------------------------------------------------------- Core -----
# Any PostgreSQL 15+ instance: local, Neon, Supabase, Railway, RDS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aigency"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------ AI providers -
# Nothing generates until at least one key is set. Keys stored in the admin
# Settings screen take precedence over these, so they can be rotated without
# a redeploy.
AI_DEFAULT_PROVIDER="openai"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""

# OpenAI-compatible endpoints need no code — just point a base URL at them.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ---------------------------------------------------------------- Billing --
BILLING_CURRENCY="USD"
SIGNUP_BONUS_CREDITS="250"
GUEST_FREE_MESSAGES="3"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

BANK_TRANSFER_ENABLED="false"

# Cap the connection pool (serverless, or a single-connection database).
DB_POOL_MAX="10"
